# Copy to .env on the server (never commit it). All values below are required unless marked optional.
DOMAIN=timesheet.bloom-india.com
DB_PASSWORD=                       # long random string: openssl rand -hex 24
JWT_SECRET=                        # long random string: openssl rand -hex 32

# Outgoing email (login codes + review notifications)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=no-reply@bloom-india.com # the mailbox that sends
SMTP_PASS=                         # its password / app password
MAIL_FROM=Bloom Timesheet <no-reply@bloom-india.com>

# optional
ALLOWED_EMAIL_DOMAIN=bloom-india.com
ADMIN_EMAIL=ankit.kumar@bloom-india.com
